{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/session-context.mjs",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/commit-policy.mjs",
        "matcher": "UserPromptSubmit",
        "timeout": 5
      }
    ],
    "subagentStart": [
      {
        "command": "node .cursor/hooks/subagent-start.mjs",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/pre-edit-guard.mjs",
        "matcher": "Write|StrReplace",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/post-edit-guard.mjs",
        "matcher": "Write|StrReplace",
        "timeout": 5
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/track-edit.mjs",
        "timeout": 3
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/commit-policy.mjs",
        "matcher": "git commit",
        "timeout": 5
      },
      {
        "command": "node .cursor/hooks/gate-before-commit.mjs",
        "matcher": "git commit",
        "timeout": 5
      },
      {
        "command": "node .cursor/hooks/shell-guards.mjs",
        "matcher": "pnpm start",
        "timeout": 5
      }
    ],
    "afterShellExecution": [
      {
        "command": "node .cursor/hooks/record-gate-pass.mjs",
        "timeout": 120
      },
      {
        "command": "node .cursor/hooks/shell-guards.mjs",
        "matcher": "pnpm test",
        "timeout": 10
      }
    ],
    "subagentStop": [
      {
        "command": "node .cursor/hooks/subagent-start.mjs",
        "timeout": 3
      },
      {
        "command": "node .cursor/hooks/subagent-stop.mjs",
        "matcher": "implementer|orchestrator-implementer",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/stop-gate-reminder.mjs",
        "loop_limit": 1,
        "timeout": 5
      }
    ],
    "preCompact": [
      {
        "command": "node .cursor/hooks/pre-compact.mjs",
        "timeout": 5
      }
    ]
  }
}
