{
  "name": "@taranti/hotspot-scanner",
  "version": "1.0.0",
  "description": "Local CLI for TS/JS maintenance hotspot analysis (NCLOC + Git churn)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/scan-result.json": "./schemas/scan-result.json",
    "./schemas/hotspot-scanner-config.json": "./schemas/hotspot-scanner-config.json",
    "./schemas/complexity-trend.json": "./schemas/complexity-trend.json",
    "./schemas/hotspot-assess.json": "./schemas/hotspot-assess.json"
  },
  "bin": {
    "hotspot-scanner": "./dist/bin/hotspot-scanner.js"
  },
  "imports": {
    "#scan": "./dist/scan.js",
    "#diagnostics": "./dist/diagnostics/index.js",
    "#report": "./dist/report/index.js",
    "#scoring": "./dist/scoring/index.js",
    "#config": "./dist/config/index.js",
    "#doctor": "./dist/doctor/index.js",
    "#git": "./dist/git/index.js",
    "#trend": "./dist/trend/index.js",
    "#assess": "./dist/assess/index.js",
    "#types": "./dist/types/index.js"
  },
  "files": [
    "dist",
    "schemas",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlanTaranti/hotspot-scanner.git"
  },
  "homepage": "https://github.com/AlanTaranti/hotspot-scanner",
  "bugs": {
    "url": "https://github.com/AlanTaranti/hotspot-scanner/issues"
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "build": "node scripts/invalidate-stale-tsbuildinfo.mjs && tsc -b tsconfig.bin.json",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.bin.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "node scripts/bench-scan.mjs",
    "hooks:smoke": "node .cursor/hooks/smoke-test.mjs"
  },
  "keywords": [
    "hotspot",
    "ncloc",
    "git",
    "maintenance",
    "refactoring",
    "typescript",
    "javascript",
    "cli",
    "code-churn",
    "tech-debt"
  ],
  "author": "Alan Taranti",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.20.0",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "ajv": "^8.20.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "picomatch": "^4.0.5"
  }
}
