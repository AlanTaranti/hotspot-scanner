{
  "name": "@vitals/hotspot-scanner",
  "version": "1.0.0",
  "description": "Local CLI for TS/JS maintenance hotspot analysis",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hotspot-scanner": "./dist/bin/hotspot-scanner.js"
  },
  "imports": {
    "#scan": "./dist/scan.js",
    "#diagnostics": "./dist/diagnostics/index.js",
    "#report": "./dist/report/index.js",
    "#scoring": "./dist/scoring/index.js",
    "#compare": "./dist/compare/index.js",
    "#config": "./dist/config/index.js"
  },
  "files": [
    "dist",
    "schemas",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taranti/hotspot-scanner.git"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.bin.json",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.bin.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "hotspot",
    "complexity",
    "git",
    "maintenance"
  ],
  "author": "Alan Taranti",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.20.0",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "ajv": "^8.20.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "picomatch": "^4.0.5",
    "ts-morph": "^28.0.0"
  }
}
