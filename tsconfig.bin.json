{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "bin",
    "outDir": "dist/bin",
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "#scan": ["src/scan.ts"],
      "#diagnostics": ["src/diagnostics/index.ts"],
      "#report": ["src/report/index.ts"],
      "#scoring": ["src/scoring/index.ts"],
      "#config": ["src/config/index.ts"],
      "#doctor": ["src/doctor/index.ts"],
      "#git": ["src/git/index.ts"],
      "#trend": ["src/trend/index.ts"],
      "#types": ["src/types/index.ts"]
    }
  },
  "references": [{ "path": "./tsconfig.json" }],
  "include": ["bin/**/*"]
}
