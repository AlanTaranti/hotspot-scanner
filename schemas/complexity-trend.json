{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitals.dev/hotspot-scanner/schemas/complexity-trend.json",
  "title": "ComplexityTrendResult",
  "description": "Complexity trend output from hotspot-scanner trend command.",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "kind", "filePath", "points", "meta"],
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "string",
      "const": "2.0"
    },
    "kind": {
      "type": "string",
      "const": "complexity-trend"
    },
    "filePath": { "type": "string" },
    "points": {
      "type": "array",
      "items": { "$ref": "#/$defs/ComplexityTrendPoint" }
    },
    "meta": { "$ref": "#/$defs/ComplexityTrendMeta" }
  },
  "$defs": {
    "ComplexityTrendPoint": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "rev",
        "indentLines",
        "indentTotal",
        "indentMean",
        "indentSd",
        "indentMax",
        "ncloc"
      ],
      "properties": {
        "rev": { "type": "string" },
        "date": { "type": "string" },
        "indentLines": { "type": "integer", "minimum": 0 },
        "indentTotal": { "type": "number", "minimum": 0 },
        "indentMean": { "type": "number", "minimum": 0 },
        "indentSd": { "type": "number", "minimum": 0 },
        "indentMax": { "type": "number", "minimum": 0 },
        "ncloc": { "type": "integer", "minimum": 0 }
      }
    },
    "ComplexityTrendWarning": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "TrendMetricLegend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "indentLines",
        "indentMean",
        "indentSd",
        "indentMax",
        "indentTotal",
        "ncloc"
      ],
      "properties": {
        "indentLines": { "type": "string" },
        "indentMean": { "type": "string" },
        "indentSd": { "type": "string" },
        "indentMax": { "type": "string" },
        "indentTotal": { "type": "string" },
        "ncloc": { "type": "string" }
      }
    },
    "ComplexityTrendMeta": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "revisionCount",
        "truncated",
        "maxRevisions",
        "sparklines",
        "metricLegend",
        "warnings"
      ],
      "properties": {
        "since": { "type": "string" },
        "start": { "type": "string" },
        "end": { "type": "string" },
        "revisionCount": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "maxRevisions": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "sparklines": {
          "type": "object",
          "additionalProperties": false,
          "required": ["indentMean", "ncloc"],
          "properties": {
            "indentMean": { "type": "string" },
            "ncloc": { "type": "string" }
          }
        },
        "metricLegend": { "$ref": "#/$defs/TrendMetricLegend" },
        "scannerVersion": { "type": "string" },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/ComplexityTrendWarning" }
        }
      }
    }
  }
}
