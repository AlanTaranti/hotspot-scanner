{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitals.dev/hotspot-scanner/schemas/complexity-trend.json",
  "title": "ComplexityTrendResult",
  "description": "Complexity trend output from hotspot-scanner trend command.",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "kind", "filePath", "points", "meta"],
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "kind": {
      "type": "string",
      "const": "complexity-trend"
    },
    "filePath": { "type": "string" },
    "points": {
      "type": "array",
      "items": { "$ref": "#/$defs/ComplexityTrendPoint" }
    },
    "meta": { "$ref": "#/$defs/ComplexityTrendMeta" }
  },
  "$defs": {
    "ComplexityTrendPoint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["rev", "n", "total", "mean", "sd", "max", "ncloc"],
      "properties": {
        "rev": { "type": "string" },
        "date": { "type": "string" },
        "n": { "type": "integer", "minimum": 0 },
        "total": { "type": "number", "minimum": 0 },
        "mean": { "type": "number", "minimum": 0 },
        "sd": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 },
        "ncloc": { "type": "integer", "minimum": 0 }
      }
    },
    "ComplexityTrendWarning": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "ComplexityTrendMeta": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "follow",
        "revisionCount",
        "truncated",
        "maxRevisions",
        "sparklines",
        "warnings"
      ],
      "properties": {
        "since": { "type": "string" },
        "start": { "type": "string" },
        "end": { "type": "string" },
        "follow": { "type": "boolean" },
        "revisionCount": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "maxRevisions": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "sparklines": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mean", "ncloc"],
          "properties": {
            "mean": { "type": "string" },
            "ncloc": { "type": "string" }
          }
        },
        "scannerVersion": { "type": "string" },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/ComplexityTrendWarning" }
        }
      }
    }
  }
}
