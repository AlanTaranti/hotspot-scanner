{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitals.dev/hotspot-scanner/schemas/compare-result.json",
  "title": "CompareResult",
  "description": "Compare output from hotspot-scanner (baseline vs current scan).",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "hotspots", "meta"],
  "properties": {
    "version": {
      "type": "string",
      "const": "3.0"
    },
    "hotspots": {
      "$ref": "#/$defs/HotspotCompareSection"
    },
    "meta": {
      "$ref": "#/$defs/CompareMeta"
    }
  },
  "$defs": {
    "RankChangeHotspot": {
      "type": "object",
      "additionalProperties": true,
      "required": ["entity", "baselineRank", "currentRank", "rankDelta"],
      "properties": {
        "entity": {
          "$ref": "scan-result.json#/$defs/HotspotScore"
        },
        "baselineRank": { "type": "integer" },
        "currentRank": { "type": "integer" },
        "rankDelta": { "type": "integer" }
      }
    },
    "HotspotCompareSection": {
      "type": "object",
      "additionalProperties": true,
      "required": ["new", "removed", "rankChanged"],
      "properties": {
        "new": {
          "type": "array",
          "items": {
            "$ref": "scan-result.json#/$defs/HotspotScore"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "scan-result.json#/$defs/HotspotScore"
          }
        },
        "rankChanged": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RankChangeHotspot"
          }
        }
      }
    },
    "CompareMeta": {
      "type": "object",
      "additionalProperties": true,
      "required": ["baseline", "current", "warnings"],
      "properties": {
        "baseline": {
          "$ref": "scan-result.json#/$defs/ScanMeta"
        },
        "current": {
          "$ref": "scan-result.json#/$defs/ScanMeta"
        },
        "warnings": {
          "type": "array",
          "items": { "$ref": "scan-result.json#/$defs/ScanWarning" }
        }
      }
    }
  }
}
